---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { SliderDefault, SliderRange, SliderStepped, SliderDisabled, SliderEcommerce } from '../../components/SliderGallery';
---

<ComponentPage
  title="Slider"
  description="An accessible slider for selecting a value or range. Built on Radix UI with full keyboard support. The range mode (two thumbs) is the primary ecommerce use case — price filtering."
  installCode="import { Slider } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>label</code>', '<code>string</code>', '—', 'Visible label above the slider. Also used to derive thumb accessible names.'],
        ['<code>min</code>', '<code>number</code>', '<code>0</code>', 'Minimum value'],
        ['<code>max</code>', '<code>number</code>', '<code>100</code>', 'Maximum value'],
        ['<code>step</code>', '<code>number</code>', '<code>1</code>', 'Increment between values'],
        ['<code>value</code>', '<code>number[]</code>', '—', 'Controlled value — one element for single mode, two for range mode'],
        ['<code>defaultValue</code>', '<code>number[]</code>', '—', 'Uncontrolled initial value'],
        ['<code>onValueChange</code>', '<code>(value: number[]) =&gt; void</code>', '—', 'Called on every value change (while dragging)'],
        ['<code>onValueCommit</code>', '<code>(value: number[]) =&gt; void</code>', '—', 'Called when the interaction ends — use this to trigger filtering'],
        ['<code>formatValue</code>', '<code>(value: number) =&gt; string</code>', '—', 'Formats values for the visible display and <code>aria-valuetext</code> (e.g. cents → "$25")'],
        ['<code>showValue</code>', '<code>boolean</code>', '<code>false</code>', 'Show the formatted value(s) beside the label'],
        ['<code>thumbLabels</code>', '<code>string[]</code>', '—', 'Accessible labels per thumb. Defaults to the label, or "&#123;label&#125; minimum" / "&#123;label&#125; maximum" in range mode.'],
        ['<code>disabled</code>', '<code>boolean</code>', '<code>false</code>', 'Disable the slider'],
      ],
    },
  ]}
  accessibility={[
    'Each thumb has <code>role="slider"</code> with <code>aria-valuenow</code>, <code>aria-valuemin</code>, and <code>aria-valuemax</code> set by Radix',
    '<code>formatValue</code> also sets <code>aria-valuetext</code> — screen readers announce "$25" instead of "2500"',
    'Full keyboard support: Arrow keys step, PageUp/PageDown step ×10, Home/End jump to min/max',
    'Thumbs have 44px hit areas via a pseudo-element — the visual thumb stays 21px (Fibonacci)',
    'Range mode names thumbs "minimum" and "maximum" by default; override with <code>thumbLabels</code>',
    'Focus states use the shared <code>--focus-ring</code>; thumb transitions respect <code>prefers-reduced-motion: reduce</code>',
  ]}
>
  <h2>Default</h2>
  <p>Single-value slider with an optional visible value.</p>
  <SliderDefault client:load />
  <pre><code>{`<Slider label="Volume" defaultValue={[60]} />
<Slider label="Brightness" defaultValue={[45]} showValue />`}</code></pre>

  <h2>Range</h2>
  <p>Pass a two-element array for a range slider — the primary use case for price filtering. <code>formatValue</code> formats both the visible value and <code>aria-valuetext</code>.</p>
  <SliderRange client:load />
  <pre><code>{`const [range, setRange] = useState([25, 80]);

<Slider
  label="Price"
  min={0}
  max={200}
  step={5}
  value={range}
  onValueChange={setRange}
  formatValue={(v) => \`$\${v}\`}
  thumbLabels={['Minimum price', 'Maximum price']}
  showValue
/>`}</code></pre>

  <h2>Stepped</h2>
  <p>Use <code>step</code> to snap values to an increment.</p>
  <SliderStepped client:load />
  <pre><code>{`<Slider label="Quantity" min={0} max={50} step={5} defaultValue={[20]} showValue />`}</code></pre>

  <h2>Disabled</h2>
  <p>Disabled sliders reduce to <code>--opacity-medium</code> and ignore all interaction.</p>
  <SliderDisabled client:load />
  <pre><code>{`<Slider label="Unavailable" defaultValue={[40]} disabled />`}</code></pre>

  <h2>Ecommerce context</h2>
  <p>Price range filter working in cents (the store convention) — <code>formatValue</code> converts to dollars for display and screen readers. Use <code>onValueCommit</code> (not <code>onValueChange</code>) to trigger collection refiltering, so it fires once per gesture.</p>
  <SliderEcommerce client:load />
  <pre><code>{`const [range, setRange] = useState([2500, 8000]); // cents

<Slider
  label="Price"
  min={0}
  max={20000}
  step={500}
  value={range}
  onValueChange={setRange}
  onValueCommit={applyPriceFilter}
  formatValue={(cents) => \`$\${(cents / 100).toFixed(0)}\`}
  thumbLabels={['Minimum price', 'Maximum price']}
  showValue
/>`}</code></pre>
</ComponentPage>
