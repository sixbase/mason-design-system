---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { DropdownMenuDefault, DropdownMenuDestructive, DropdownMenuSelection, DropdownMenuDisabled } from '../../components/DropdownMenuGallery';
---

<ComponentPage
  title="Dropdown Menu"
  description="An accessible action menu built on Radix UI DropdownMenu — full keyboard navigation, typeahead, correct menu ARIA roles, and collision-aware positioning. Common ecommerce uses: account menu, order actions, filter and sort controls."
  installCode="import { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem, DropdownMenuCheckboxItem, DropdownMenuRadioGroup, DropdownMenuRadioItem, DropdownMenuLabel, DropdownMenuSeparator } from '@ds/components';"
  props={[
    {
      name: 'DropdownMenuContent',
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>side</code>', "<code>'top' | 'right' | 'bottom' | 'left'</code>", "<code>'bottom'</code>", 'Preferred side — flips on collision'],
        ['<code>align</code>', "<code>'start' | 'center' | 'end'</code>", "<code>'start'</code>", 'Alignment along the trigger edge'],
        ['<code>sideOffset</code>', '<code>number</code>', '<code>4</code>', 'Gap from trigger (= <code>--spacing-1</code>)'],
      ],
    },
    {
      name: 'DropdownMenuItem',
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>variant</code>', "<code>'default' | 'destructive'</code>", "<code>'default'</code>", 'Destructive for irreversible actions'],
        ['<code>disabled</code>', '<code>boolean</code>', '<code>false</code>', 'Prevent selection'],
        ['<code>onSelect</code>', '<code>(event: Event) =&gt; void</code>', '—', 'Called when the item is activated'],
      ],
    },
    {
      name: 'DropdownMenuCheckboxItem / DropdownMenuRadioItem',
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>checked</code>', '<code>boolean</code>', '—', 'Checkbox item checked state'],
        ['<code>onCheckedChange</code>', '<code>(checked: boolean) =&gt; void</code>', '—', 'Checkbox change handler'],
        ['<code>value</code>', '<code>string</code>', '—', 'Radio item value (within <code>DropdownMenuRadioGroup</code>)'],
      ],
    },
  ]}
  accessibility={[
    'Keyboard: <kbd>↑</kbd> <kbd>↓</kbd> navigate, <kbd>Enter</kbd>/<kbd>Space</kbd> activate, <kbd>Escape</kbd> close, typeahead jumps to matching items',
    'Correct roles: <code>menu</code>, <code>menuitem</code>, <code>menuitemcheckbox</code>, <code>menuitemradio</code> with <code>aria-checked</code>',
    'Items meet the 34px minimum control height, expanding to 44px hit areas on touch (coarse pointer) devices',
    'Positioning is collision-aware with <code>--spacing-4</code> viewport padding, so menus never clip on small screens',
  ]}
>
  <h2>Default</h2>
  <DropdownMenuDefault client:load />
  <pre><code>{`<DropdownMenu>
  <DropdownMenuTrigger asChild>
    <Button variant="secondary">Account</Button>
  </DropdownMenuTrigger>
  <DropdownMenuContent>
    <DropdownMenuItem>Profile</DropdownMenuItem>
    <DropdownMenuItem>Orders</DropdownMenuItem>
    <DropdownMenuSeparator />
    <DropdownMenuItem>Sign out</DropdownMenuItem>
  </DropdownMenuContent>
</DropdownMenu>`}</code></pre>

  <h2>Label and destructive item</h2>
  <DropdownMenuDestructive client:load />
  <pre><code>{`<DropdownMenuContent>
  <DropdownMenuLabel>Order actions</DropdownMenuLabel>
  <DropdownMenuItem>View details</DropdownMenuItem>
  <DropdownMenuSeparator />
  <DropdownMenuItem variant="destructive">Cancel order</DropdownMenuItem>
</DropdownMenuContent>`}</code></pre>

  <h2>Checkbox and radio items</h2>
  <DropdownMenuSelection client:load />
  <pre><code>{`{/* Checkbox items */}
<DropdownMenuCheckboxItem checked={inStock} onCheckedChange={setInStock}>
  In stock only
</DropdownMenuCheckboxItem>

{/* Radio items */}
<DropdownMenuRadioGroup value={sort} onValueChange={setSort}>
  <DropdownMenuRadioItem value="featured">Featured</DropdownMenuRadioItem>
  <DropdownMenuRadioItem value="newest">Newest arrivals</DropdownMenuRadioItem>
</DropdownMenuRadioGroup>`}</code></pre>

  <h2>Disabled items</h2>
  <DropdownMenuDisabled client:load />
  <pre><code>{`<DropdownMenuItem disabled>Return items (window closed)</DropdownMenuItem>`}</code></pre>
</ComponentPage>
