---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { ContainerSizes, ContainerFluid, ContainerNested } from '../../components/ContainerGallery';
---

<ComponentPage
  title="Container"
  description="A centered, max-width wrapper with responsive horizontal padding that respects device safe areas. For the page shell use <code>PageContainer</code> from the <a href='layout-grid'>Layout Grid</a>; <code>Container</code> is for non-page contexts (Header, Footer, drawers, embedded layouts)."
  installCode="import { Container } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>size</code>', "<code>'sm' | 'md' | 'lg' | 'xl'</code>", "<code>'xl'</code>", 'Max-width: 640 / 768 / 960 / 1280px'],
        ['<code>fluid</code>', '<code>boolean</code>', '<code>false</code>', 'Removes max-width, keeps padding'],
        ['<code>noPadding</code>', '<code>boolean</code>', '<code>false</code>', 'Removes horizontal padding (for nesting)'],
      ],
    },
  ]}
  accessibility={[
    'Pure layout component — no interactive behavior, no ARIA required',
    'Safe-area padding keeps content out of notches and curved screen edges on mobile devices',
  ]}
>
  <h2>Sizes</h2>
  <p>Four max-widths from the <code>--size-content-*</code> tokens. All center themselves and share the same responsive padding.</p>
  <ContainerSizes client:load />
  <pre><code>{`<Container size="sm">…</Container>
<Container size="md">…</Container>
<Container size="lg">…</Container>
<Container>…</Container>  {/* xl — default */}`}</code></pre>

  <h2>Fluid</h2>
  <p>No max-width — the content spans the full viewport but keeps the responsive padding.</p>
  <ContainerFluid client:load />
  <pre><code>{`<Container fluid>…</Container>`}</code></pre>

  <h2>Nesting</h2>
  <p>
    When a container sits inside another, give the inner one <code>noPadding</code> so padding
    isn't applied twice.
  </p>
  <ContainerNested client:load />
  <pre><code>{`<Container size="lg">
  <Container noPadding>…</Container>
</Container>`}</code></pre>

  <h2>Safe areas</h2>
  <p>
    Horizontal padding is computed as
    <code>max(spacing-token, var(--safe-area-left/right))</code>. On regular screens the token
    wins, so nothing changes visually. On devices with notches or curved edges (in landscape,
    or PWAs with <code>viewport-fit=cover</code>), the padding grows to the reported
    <code>env(safe-area-inset-*)</code> so content never hides behind the hardware. No prop
    needed — it's built in.
  </p>
  <pre><code>{`/* Container.css */
padding-inline:
  max(var(--spacing-4), var(--safe-area-left))
  max(var(--spacing-4), var(--safe-area-right));`}</code></pre>
</ComponentPage>
