---
import ComponentPage from '../../layouts/ComponentPage.astro';
import {
  CountdownDefault,
  CountdownSizes,
  CountdownCustomLabels,
  CountdownHideZeroUnits,
  CountdownCompletion,
} from '../../components/CountdownGallery';
---

<ComponentPage
  title="Countdown"
  description="A sale and promotion timer that counts down to a target moment. Digits render in the numeric monospace family with tabular figures, so segment widths never jitter as values tick."
  installCode="import { Countdown } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>target</code>', '<code>Date | string</code>', '—', 'Target moment (Date or ISO 8601 string). Required.'],
        ['<code>onComplete</code>', '<code>() =&gt; void</code>', '—', 'Called exactly once when the target passes.'],
        ['<code>labels</code>', '<code>Partial&lt;CountdownLabels&gt;</code>', "<code>{ days: 'days', hours: 'hrs', minutes: 'mins', seconds: 'secs' }</code>", 'Custom unit labels, merged over the defaults.'],
        ['<code>hideZeroUnits</code>', '<code>boolean</code>', '<code>false</code>', 'Drop leading units whose value is zero (e.g. hide "00 days").'],
        ['<code>size</code>', "<code>'sm' | 'md'</code>", "<code>'md'</code>", 'Size variant.'],
      ],
    },
  ]}
  accessibility={[
    'Root renders with <code>role="timer"</code>',
    'The per-second visible digits are <code>aria-hidden="true"</code> — a ticking timer must not spam screen readers with an announcement every second',
    'A single visually-hidden <code>aria-live="polite"</code> region carries a human phrase ("2 days, 3 hours remaining"). The phrase deliberately excludes seconds, so its text changes at most once per minute — and assistive technology only announces a live region when its text changes',
    'Under one minute the phrase is the constant "Less than a minute remaining" (announced once); on completion it becomes "Countdown complete" (announced once)',
    'The live region is hidden with the clip-path technique, not <code>display: none</code>, which would silence it',
    'The interval recomputes from <code>Date.now()</code> on every tick (drift-corrected) and is cleaned up on unmount',
  ]}
>
  <h2>Default</h2>
  <p>Four segments — days, hours, minutes, seconds — separated by colons. Digits use <code>--font-family-numeric</code> with tabular figures for stable widths.</p>
  <CountdownDefault client:load />
  <pre><code>{`<Countdown target={new Date('2026-08-01T00:00:00Z')} />`}</code></pre>

  <h2>Sizes</h2>
  <CountdownSizes client:load />
  <pre><code>{`<Countdown target={saleEnds} size="md" />
<Countdown target={saleEnds} size="sm" />`}</code></pre>

  <h2>Custom labels</h2>
  <p>Override any subset of unit labels with the <code>labels</code> prop.</p>
  <CountdownCustomLabels client:load />
  <pre><code>{`<Countdown
  target={saleEnds}
  labels={{ days: 'd', hours: 'h', minutes: 'm', seconds: 's' }}
/>`}</code></pre>

  <h2>Hide zero units</h2>
  <p>With <code>hideZeroUnits</code>, leading zero-value units are dropped — a 45-minute timer shows only minutes and seconds.</p>
  <CountdownHideZeroUnits client:load />
  <pre><code>{`<Countdown target={endsIn45Minutes} hideZeroUnits />
<Countdown target={endsIn3Hours} hideZeroUnits />`}</code></pre>

  <h2>Completion</h2>
  <p>When the target passes, the display settles at zeros and <code>onComplete</code> fires exactly once.</p>
  <CountdownCompletion client:load />
  <pre><code>{`<Countdown
  target={saleEnds}
  hideZeroUnits
  onComplete={() => setSaleEnded(true)}
/>`}</code></pre>
</ComponentPage>
