---
import ComponentPage from '../../layouts/ComponentPage.astro';
import {
  GridResponsive,
  GridPerAxisGaps,
  GridAlignment,
  GridAutoFit,
} from '../../components/GridGallery';
---

<ComponentPage
  title="Grid"
  description="Responsive repeating grid for product cards and other uniform content. Columns step 1 → 2 → 3 → 4 across breakpoints, gaps come from spacing tokens, and an auto-fit mode derives the column count from a minimum child width. For section-level page composition use the <a href='layout-grid'>Layout Grid</a> instead."
  installCode="import { Grid } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>cols</code>', '<code>1–6</code>', '<code>1</code>', 'Columns below 640px'],
        ['<code>colsSm</code>', '<code>1–6</code>', '<code>2</code>', 'Columns at 640px+'],
        ['<code>colsMd</code>', '<code>1–6</code>', '<code>3</code>', 'Columns at 768px+'],
        ['<code>colsLg</code>', '<code>1–6</code>', '<code>4</code>', 'Columns at 1024px+'],
        ['<code>gap</code>', '<code>GridGap</code> (spacing scale)', '<code>4</code> → <code>6</code> at lg', 'Both axes, e.g. <code>4</code> = <code>--spacing-4</code>'],
        ['<code>rowGap</code>', '<code>GridGap</code> (spacing scale)', '—', 'Row axis override'],
        ['<code>columnGap</code>', '<code>GridGap</code> (spacing scale)', '—', 'Column axis override'],
        ['<code>alignItems</code>', "<code>'start' | 'center' | 'end' | 'stretch'</code>", '—', 'Block-axis item alignment'],
        ['<code>justifyItems</code>', "<code>'start' | 'center' | 'end' | 'stretch'</code>", '—', 'Inline-axis item alignment'],
        ['<code>minChildWidth</code>', '<code>string</code> (CSS length)', '—', 'Auto-fit mode — overrides all column counts'],
      ],
    },
  ]}
  accessibility={[
    'Pure layout component — no interactive behavior, no ARIA required',
    'Reading order follows DOM order at every breakpoint',
  ]}
>
  <h2>Responsive columns</h2>
  <p>
    The default steps 1 → 2 → 3 → 4 columns across breakpoints with token gaps
    (<code>--spacing-4</code>, stepping to <code>--spacing-6</code> at desktop). Override any
    breakpoint with the <code>cols*</code> props.
  </p>
  <GridResponsive client:load />
  <pre><code>{`<Grid>{cards}</Grid>

<Grid cols={2} colsMd={3} colsLg={4}>
  {products.map(p => <ProductCard key={p.id} fluid {...p} />)}
</Grid>`}</code></pre>

  <h2>Per-axis gaps</h2>
  <p>
    <code>rowGap</code> and <code>columnGap</code> take the same spacing-token scale as
    <code>gap</code> and override it per axis — useful when cards need more breathing room
    between rows than between columns.
  </p>
  <GridPerAxisGaps client:load />
  <pre><code>{`<Grid colsLg={3} rowGap={8} columnGap={3}>
  {cards}
</Grid>`}</code></pre>

  <h2>Item alignment</h2>
  <p>
    <code>alignItems</code> and <code>justifyItems</code> align items within their cells when
    children have different intrinsic sizes.
  </p>
  <GridAlignment client:load />
  <pre><code>{`<Grid colsLg={3} alignItems="center">
  {mixedHeightItems}
</Grid>`}</code></pre>

  <h2>Auto-fit (minChildWidth)</h2>
  <p>
    Pass <code>minChildWidth</code> and the grid derives its column count from the available
    space instead of fixed breakpoint counts:
    <code>repeat(auto-fill, minmax(min(100%, width), 1fr))</code>. The <code>min(100%, …)</code>
    guard prevents overflow on narrow screens. When set, all <code>cols*</code> props are ignored.
    Prefer a token reference or a <code>ch</code> measure over raw pixels.
  </p>
  <GridAutoFit client:load />
  <pre><code>{`<Grid minChildWidth="18ch">
  {cards}
</Grid>`}</code></pre>
</ComponentPage>
