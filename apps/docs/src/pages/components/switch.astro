---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { SwitchStates, SwitchWithText, SwitchSizes, SwitchSettings } from '../../components/SwitchGallery';
---

<ComponentPage
  title="Switch"
  description="An accessible toggle switch built on Radix UI. Label, hint, and error all built in. Use for instant on/off settings — unlike a checkbox, a switch implies the change takes effect immediately. Common ecommerce uses: notification preferences, gift wrapping toggle, marketing opt-in."
  installCode="import { Switch } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>label</code>', '<code>string</code>', '—', 'Visible label'],
        ['<code>hint</code>', '<code>string</code>', '—', 'Helper text below'],
        ['<code>error</code>', '<code>string</code>', '—', 'Error message'],
        ['<code>size</code>', "<code>'sm' | 'md'</code>", "<code>'md'</code>", 'Switch size'],
        ['<code>checked</code>', '<code>boolean</code>', '—', 'Controlled checked state'],
        ['<code>defaultChecked</code>', '<code>boolean</code>', '<code>false</code>', 'Uncontrolled initial state'],
        ['<code>disabled</code>', '<code>boolean</code>', '<code>false</code>', 'Disable interaction'],
        ['<code>onCheckedChange</code>', '<code>(checked: boolean) =&gt; void</code>', '—', 'Change handler'],
      ],
    },
  ]}
  accessibility={[
    'Renders with <code>role="switch"</code> and <code>aria-checked</code> (Radix handles this)',
    'Label is associated via <code>htmlFor</code>/<code>id</code> — clicking the label toggles the switch',
    'Keyboard: <kbd>Space</kbd> and <kbd>Enter</kbd> toggle',
    'Error message is announced via <code>role="alert"</code>',
    'Hit area extends to 44px even at small sizes',
    'Thumb animation is disabled under <code>prefers-reduced-motion</code>',
  ]}
>
  <h2>States</h2>
  <SwitchStates client:load />
  <pre><code>{`<Switch label="Off" />
<Switch label="On" defaultChecked />
<Switch label="Disabled" disabled />
<Switch label="Disabled on" disabled defaultChecked />`}</code></pre>

  <h2>With hint and error</h2>
  <SwitchWithText client:load />
  <pre><code>{`<Switch
  label="Gift wrapping"
  hint="Adds $5.00 at checkout"
/>
<Switch
  label="I accept the subscription terms"
  error="You must enable this to continue"
/>`}</code></pre>

  <h2>Sizes</h2>
  <SwitchSizes client:load />
  <pre><code>{`<Switch size="md" label="Medium (default)" defaultChecked />
<Switch size="sm" label="Small" defaultChecked />`}</code></pre>

  <h2>Notification settings</h2>
  <p>A typical account-settings panel — each switch applies immediately.</p>
  <SwitchSettings client:load />
  <pre><code>{`<Switch label="Order updates" defaultChecked hint="Shipping and delivery notifications" />
<Switch label="Restock alerts" hint="When wishlist items are back in stock" />
<Switch label="Promotions" hint="Sales, discounts, and early access" />
<Switch label="SMS notifications" disabled hint="Add a phone number to enable" />`}</code></pre>
</ComponentPage>
