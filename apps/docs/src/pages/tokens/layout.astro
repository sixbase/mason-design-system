---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/token-docs.css';
---

<BaseLayout title="Layout">
  <div class="prose">
    <h1>Layout</h1>
    <p>
      The grid system defines how every page is structured — breakpoints, containers, product grids,
      section spacing, and two-column layouts. This is the canonical reference for building pages
      and translating the design system to a Shopify theme.
    </p>

    <!-- ─── Breakpoints ──────────────────────────────────── -->

    <h2>Breakpoints</h2>
    <p class="section-desc">
      Four breakpoints, mobile-first. All components use <code>min-width</code> media queries at these values.
      <code>xl</code> is not a media query — it doubles as the Container component's widest size.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Value</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>sm</code></td>
          <td>640px</td>
          <td>Two-column grids, compact tablet</td>
        </tr>
        <tr>
          <td><code>md</code></td>
          <td>768px</td>
          <td>Standard tablet, container padding steps up</td>
        </tr>
        <tr>
          <td><code>lg</code></td>
          <td>1024px</td>
          <td>Desktop — 4-column grids, gap steps up, sticky sidebars</td>
        </tr>
        <tr>
          <td><code>xl</code></td>
          <td>1280px</td>
          <td>Container component's <code>xl</code> size — not a media query (page frames: see "Page frame widths" below)</td>
        </tr>
      </tbody>
    </table>

    <div class="layout-note">
      <strong>Shopify mapping:</strong> These map directly to Shopify theme media queries.
      Define them as CSS custom properties in your theme's <code>base.css</code>.
    </div>

    <!-- ─── Container ────────────────────────────────────── -->

    <h2>Container</h2>
    <p class="section-desc">
      Horizontally centers content with a max-width and responsive padding.
      Content goes <em>inside</em> a Container. Full-bleed backgrounds go <em>outside</em>.
    </p>

    <h3>Padding progression</h3>
    <table class="layout-table">
      <thead>
        <tr>
          <th>Viewport</th>
          <th>Token</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 768px</td>
          <td><code>--spacing-4</code></td>
          <td>16px</td>
        </tr>
        <tr>
          <td>≥ 768px</td>
          <td><code>--spacing-8</code></td>
          <td>32px</td>
        </tr>
        <tr>
          <td>≥ 1024px</td>
          <td><code>--spacing-16</code></td>
          <td>64px</td>
        </tr>
      </tbody>
    </table>

    <h3>Size variants</h3>
    <table class="layout-table">
      <thead>
        <tr>
          <th>Size</th>
          <th>Max-width</th>
          <th>Use case</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>sm</code></td>
          <td>640px</td>
          <td>Auth forms, dialogs, narrow overlays</td>
        </tr>
        <tr>
          <td><code>md</code></td>
          <td>768px</td>
          <td>Legal/prose content, settings panels</td>
        </tr>
        <tr>
          <td><code>lg</code></td>
          <td>960px</td>
          <td>Feature sections, wide forms</td>
        </tr>
        <tr>
          <td><code>xl</code> <span class="scale-badge scale-badge--primary">default</span></td>
          <td>1280px</td>
          <td>Widest Container size — not the page frame (see below)</td>
        </tr>
      </tbody>
    </table>

    <h3>Page frame widths</h3>
    <p>
      Two page frames exist, one per surface. The 12-column grid inside them is identical —
      only the frame width differs.
    </p>
    <table class="layout-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Value</th>
          <th>Used by</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--size-container</code></td>
          <td>1200px</td>
          <td>Design system &amp; docs — <code>.ds-page-container</code>, Header, Footer</td>
        </tr>
        <tr>
          <td><code>--size-container-wide</code></td>
          <td>1396px</td>
          <td>Shopify storefront — its whole page frame. <strong>1300px visible</strong> after the 48px desktop padding</td>
        </tr>
      </tbody>
    </table>
    <p>
      The storefront runs the wide frame on purpose — product grids and imagery use the room,
      documentation prose doesn't. Don't port either value to the other surface.
      (The Container component's <code>xl</code> size, 1280px, is a content width — not a page frame.)
    </p>

    <pre><code>{`import { Container } from '@ds/components';

{/* Standard page wrapper */}
<Container>
  <h1>Page content</h1>
</Container>

{/* Narrow prose content */}
<Container size="md">
  <article>Long-form text...</article>
</Container>

{/* Full-bleed background with contained content */}
<section style={{ background: 'var(--color-background-subtle)' }}>
  <Container>
    <h2>Featured section</h2>
  </Container>
</section>`}</code></pre>

    <div class="layout-note">
      <strong>Shopify mapping:</strong> Container = Shopify's <code>page-width</code> class.
      The padding progression becomes CSS custom properties on <code>.page-width</code>.
    </div>

    <!-- ─── Product Grid ─────────────────────────────────── -->

    <h2>Product Grid</h2>
    <p class="section-desc">
      The standard layout for product listings. Uses a 2-tier gap system —
      tighter on mobile/tablet, more breathing room on desktop.
    </p>

    <h3>Column progression</h3>
    <table class="layout-table">
      <thead>
        <tr>
          <th>Viewport</th>
          <th>Columns</th>
          <th>Gap token</th>
          <th>Gap value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 640px</td>
          <td>1</td>
          <td><code>--spacing-4</code></td>
          <td>16px</td>
        </tr>
        <tr>
          <td>≥ 640px (sm)</td>
          <td>2</td>
          <td><code>--spacing-4</code></td>
          <td>16px</td>
        </tr>
        <tr>
          <td>≥ 768px (md)</td>
          <td>3</td>
          <td><code>--spacing-4</code></td>
          <td>16px</td>
        </tr>
        <tr>
          <td>≥ 1024px (lg)</td>
          <td>4</td>
          <td><code>--spacing-6</code></td>
          <td>24px</td>
        </tr>
      </tbody>
    </table>

    <div class="layout-rule">
      <strong>Rule:</strong> All cards inside a Grid must use the <code>fluid</code> prop.
      Never use fixed-width cards in a grid — the grid cell defines the width.
    </div>

    <pre><code>{`import { Grid, ProductCard } from '@ds/components';

{/* Standard product grid — 1→2→3→4 columns */}
<Grid cols={2} colsSm={2} colsMd={3} colsLg={4}>
  {products.map((product) => (
    <ProductCard fluid name={product.name} price={product.price} image={product.image} />
  ))}
</Grid>`}</code></pre>

    <div class="layout-note">
      <strong>Shopify mapping:</strong> Grid = the collection product grid section.
      Column counts and gap values become section settings in <code>{'{% schema %}'}</code>.
    </div>

    <!-- ─── Two-Column Layouts ───────────────────────────── -->

    <h2>Two-Column Layouts</h2>
    <p class="section-desc">
      Product detail and cart pages use a golden-ratio split at desktop,
      collapsing to a single column on mobile.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Viewport</th>
          <th>Layout</th>
          <th>Ratio</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 1024px</td>
          <td>Single column (stacked)</td>
          <td>1fr</td>
        </tr>
        <tr>
          <td>≥ 1024px</td>
          <td>Two columns</td>
          <td>1.618fr 1fr (golden ratio)</td>
        </tr>
      </tbody>
    </table>

    <pre><code>{`/* PDP / Cart two-column layout */
.page-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-6);
}

@media (min-width: 1024px) {
  .page-layout {
    grid-template-columns: 1.618fr 1fr;
  }
}

/* Breadcrumb spans both columns */
.page-layout__breadcrumb {
  grid-column: 1 / -1;
}

/* Details column sticks on desktop */
@media (min-width: 1024px) {
  .page-layout__sidebar {
    position: sticky;
    top: var(--spacing-6);
    align-self: start;
  }
}`}</code></pre>

    <div class="layout-note">
      <strong>Shopify mapping:</strong> This becomes a custom section with two blocks.
      The ratio and sticky behavior are defined in the section's CSS.
    </div>

    <!-- ─── Section Spacing ──────────────────────────────── -->

    <h2>Section Spacing</h2>
    <p class="section-desc">
      Vertical rhythm between page sections uses <strong>phi tokens</strong>.
      Component internals use standard tokens. Never mix the two scales within a component.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Value</th>
          <th>Use case</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--spacing-phi-13</code></td>
          <td>26px</td>
          <td>Within-section gaps (heading to content, filter bar to grid)</td>
        </tr>
        <tr>
          <td><code>--spacing-phi-21</code></td>
          <td>42px</td>
          <td>Between related sections (feature block gaps)</td>
        </tr>
        <tr>
          <td><code>--spacing-phi-34</code></td>
          <td>68px</td>
          <td>Major section breaks (hero to content, content to newsletter)</td>
        </tr>
      </tbody>
    </table>

    <div class="layout-note">
      <strong>Shopify mapping:</strong> Section spacing becomes CSS custom properties
      on Shopify section containers, controlled via theme settings.
    </div>

    <!-- ─── Carousel ─────────────────────────────────────── -->

    <h2>Carousel</h2>
    <p class="section-desc">
      Carousels use flex-based horizontal scroll with snap points — not CSS Grid.
      Cards inside carousels must use the <code>fluid</code> prop to fill their slide.
    </p>

    <h3>Slide sizes</h3>
    <table class="layout-table">
      <thead>
        <tr>
          <th>Size</th>
          <th>&lt; 768px</th>
          <th>≥ 768px</th>
          <th>≥ 1024px</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>sm</code></td>
          <td>70%</td>
          <td>45%</td>
          <td>33.3%</td>
        </tr>
        <tr>
          <td><code>md</code></td>
          <td>85%</td>
          <td>65%</td>
          <td>50%</td>
        </tr>
        <tr>
          <td><code>lg</code></td>
          <td>95%</td>
          <td>80%</td>
          <td>66.6%</td>
        </tr>
      </tbody>
    </table>

    <pre><code>{`import { Carousel, CarouselSlide, ProductCard } from '@ds/components';

<Carousel gap="md">
  {products.map((product) => (
    <CarouselSlide size="sm">
      <ProductCard fluid name={product.name} price={product.price} image={product.image} />
    </CarouselSlide>
  ))}
</Carousel>`}</code></pre>

    <!-- ─── Aspect Ratios ────────────────────────────────── -->

    <h2>Aspect Ratios</h2>
    <p class="section-desc">
      Tokenized proportions for image and media containers — always
      <code>aspect-ratio: var(--aspect-*)</code>, never a raw ratio. Two φ ratios for
      editorial moments, plus the practical media ratios components already use.
    </p>

    <div class="aspect-grid">
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-square);"></div>
        <code class="aspect-name">--aspect-square</code>
        <span class="aspect-usage">1 / 1 — avatars, thumbnails, cart line images</span>
      </div>
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-portrait);"></div>
        <code class="aspect-name">--aspect-portrait</code>
        <span class="aspect-usage">4 / 5 — product cards, gallery images</span>
      </div>
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-landscape);"></div>
        <code class="aspect-name">--aspect-landscape</code>
        <span class="aspect-usage">4 / 3 — default card image ratio</span>
      </div>
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-video);"></div>
        <code class="aspect-name">--aspect-video</code>
        <span class="aspect-usage">16 / 9 — video embeds, wide media banners</span>
      </div>
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-golden);"></div>
        <code class="aspect-name">--aspect-golden</code>
        <span class="aspect-usage">φ : 1 — hero images, editorial banners</span>
      </div>
      <div class="aspect-swatch">
        <div class="aspect-sample" style="aspect-ratio: var(--aspect-golden-portrait);"></div>
        <code class="aspect-name">--aspect-golden-portrait</code>
        <span class="aspect-usage">1 : φ — editorial and campaign imagery</span>
      </div>
    </div>

    <div class="layout-note">
      <strong>φ note:</strong> 4/5 (0.8) is the practical neighbor of 1/√φ ≈ 0.786 — the
      product standard agreed with the storefront. The golden pair carries the exact φ proportion.
    </div>

    <!-- ─── Elevation ────────────────────────────────────── -->

    <h2>Elevation</h2>
    <p class="section-desc">
      Semantic aliases over the Fibonacci shadow scale. Components declare what a surface
      <em>is</em> (<code>--elevation-card</code>), not which shadow it wears (<code>--shadow-md</code>) —
      retuning the shadow scale flows through every elevation automatically.
    </p>

    <div class="elevation-grid">
      <div class="elevation-swatch">
        <div class="elevation-sample" style="box-shadow: var(--elevation-card);"></div>
        <code class="elevation-name">--elevation-card</code>
        <span class="elevation-usage">shadow-md — resting cards, tiles</span>
      </div>
      <div class="elevation-swatch">
        <div class="elevation-sample" style="box-shadow: var(--elevation-dropdown);"></div>
        <code class="elevation-name">--elevation-dropdown</code>
        <span class="elevation-usage">shadow-lg — menus, popovers, tooltips</span>
      </div>
      <div class="elevation-swatch">
        <div class="elevation-sample" style="box-shadow: var(--elevation-sticky);"></div>
        <code class="elevation-name">--elevation-sticky</code>
        <span class="elevation-usage">shadow-lg — sticky bars once scrolled</span>
      </div>
      <div class="elevation-swatch">
        <div class="elevation-sample" style="box-shadow: var(--elevation-modal);"></div>
        <code class="elevation-name">--elevation-modal</code>
        <span class="elevation-usage">shadow-xl — modal dialogs</span>
      </div>
      <div class="elevation-swatch">
        <div class="elevation-sample" style="box-shadow: var(--elevation-toast);"></div>
        <code class="elevation-name">--elevation-toast</code>
        <span class="elevation-usage">shadow-2xl — toasts, drawers</span>
      </div>
    </div>

    <!-- ─── Safe Area ────────────────────────────────────── -->

    <h2>Safe Area</h2>
    <p class="section-desc">
      Device inset tokens for notches, home indicators, and curved corners. Each wraps
      <code>env(safe-area-inset-*)</code> with a <code>0px</code> fallback, so they're inert
      on desktop. Requires <code>viewport-fit=cover</code> in the viewport meta tag.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Value</th>
          <th>Use case</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--safe-area-top</code></td>
          <td><code>env(safe-area-inset-top, 0px)</code></td>
          <td>Fixed headers under a notch</td>
        </tr>
        <tr>
          <td><code>--safe-area-right</code></td>
          <td><code>env(safe-area-inset-right, 0px)</code></td>
          <td>Landscape edge padding</td>
        </tr>
        <tr>
          <td><code>--safe-area-bottom</code></td>
          <td><code>env(safe-area-inset-bottom, 0px)</code></td>
          <td>Bottom bars, drawers, toasts above the home indicator</td>
        </tr>
        <tr>
          <td><code>--safe-area-left</code></td>
          <td><code>env(safe-area-inset-left, 0px)</code></td>
          <td>Landscape edge padding</td>
        </tr>
      </tbody>
    </table>

    <pre><code>{`/* Bottom bar clears the home indicator on notched devices */
.cart-bar {
  padding-bottom: calc(var(--spacing-4) + var(--safe-area-bottom));
}`}</code></pre>

    <!-- ─── Interaction ──────────────────────────────────── -->

    <h2>Interaction</h2>
    <p class="section-desc">
      Shared physical constants for interactive behavior — press feedback, touch targets,
      and gesture thresholds.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Token</th>
          <th>Value</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>--scale-press</code></td>
          <td>0.98</td>
          <td>Pressed-state <code>transform: scale(var(--scale-press))</code> on buttons, checkboxes, options</td>
        </tr>
        <tr>
          <td><code>--size-hit-area</code></td>
          <td>44px</td>
          <td>Minimum invisible touch <strong>hit zone</strong> (Apple HIG / WCAG 2.5.8). Extend with padding or a pseudo-element — not by growing the visual</td>
        </tr>
        <tr>
          <td><code>--size-touch-target</code></td>
          <td>36px</td>
          <td>The <strong>visual</strong> icon-button size — stays 36px; the hit area around it is what must reach 44px</td>
        </tr>
        <tr>
          <td><code>--size-swipe-threshold</code></td>
          <td>50px</td>
          <td>Minimum drag distance to register a swipe (carousels, drawers) — JS-consumable via the tokens JSON export</td>
        </tr>
      </tbody>
    </table>

    <div class="layout-rule">
      <strong>Try it:</strong> the sample below scales to <code>var(--scale-press)</code> while pressed.
    </div>
    <button type="button" class="press-demo">Press and hold</button>

    <!-- ─── Shopify Theme Mapping ────────────────────────── -->

    <h2>Shopify Theme Mapping</h2>
    <p class="section-desc">
      Reference for translating this design system to a Shopify theme.
    </p>

    <table class="layout-table">
      <thead>
        <tr>
          <th>Design System</th>
          <th>Shopify Theme</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Container</td>
          <td><code>.page-width</code> class</td>
        </tr>
        <tr>
          <td>Grid</td>
          <td>Collection product grid section</td>
        </tr>
        <tr>
          <td>Spacing tokens</td>
          <td>CSS custom properties in <code>base.css</code></td>
        </tr>
        <tr>
          <td>Breakpoints</td>
          <td>Media queries in theme CSS</td>
        </tr>
        <tr>
          <td>Page sections</td>
          <td>Shopify sections with <code>{'{% schema %}'}</code></td>
        </tr>
        <tr>
          <td>Section spacing</td>
          <td>Section padding theme settings</td>
        </tr>
        <tr>
          <td>Two-column layout</td>
          <td>Custom section with two blocks</td>
        </tr>
        <tr>
          <td>Carousel</td>
          <td>Featured collection / slideshow section</td>
        </tr>
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  /* ─── Layout tables ────────────────────────────────── */
  .layout-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
    margin: var(--spacing-3) 0 var(--spacing-6);
  }

  .layout-table th {
    text-align: left;
    font-weight: var(--font-weight-semibold);
    padding: var(--spacing-2) var(--spacing-3);
    border-bottom: 2px solid var(--color-border);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-foreground-secondary);
  }

  /* @breakpoint-sm = 640px — table scrolls within itself on phones */
  @media (max-width: 639px) {
    .layout-table {
      display: block;
      overflow-x: auto;
    }
  }

  .layout-table td {
    padding: var(--spacing-2) var(--spacing-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .layout-table td code {
    font-size: var(--font-size-xs);
    background: none;
    border: none;
    padding: 0;
  }

  .layout-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* ─── Callout boxes ────────────────────────────────── */
  .layout-note {
    font-size: var(--font-size-sm);
    color: var(--color-foreground-subtle);
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-background-subtle);
    border-radius: var(--radius-md);
    margin: var(--spacing-4) 0 var(--spacing-6);
    line-height: var(--line-height-relaxed);
  }

  .layout-note strong {
    color: var(--color-foreground);
  }

  .layout-rule {
    font-size: var(--font-size-sm);
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-warning-subtle);
    border-left: 3px solid var(--color-warning);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--spacing-4) 0 var(--spacing-4);
    line-height: var(--line-height-relaxed);
  }

  .layout-rule strong {
    color: var(--color-foreground);
  }

  .layout-rule code {
    font-size: var(--font-size-xs);
  }

  /* ─── Aspect ratio grid ────────────────────────────── */
  .aspect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--spacing-6);
    align-items: end;
    margin: var(--spacing-3) 0 var(--spacing-6);
  }

  .aspect-swatch {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .aspect-sample {
    width: 100%;
    background-color: var(--color-background-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .aspect-name {
    font-size: var(--font-size-xs);
    background: none;
    border: none;
    padding: 0;
    color: var(--color-foreground);
  }

  .aspect-usage {
    font-size: var(--font-size-xs);
    color: var(--color-foreground-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* ─── Elevation grid ───────────────────────────────── */
  .elevation-grid {
    display: grid;
