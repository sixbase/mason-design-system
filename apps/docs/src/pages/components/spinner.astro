---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { SpinnerDefault, SpinnerSizes, SpinnerWithLabel } from '../../components/SpinnerGallery';
---

<ComponentPage
  title="Spinner"
  description="A standalone loading indicator using the same visual language as the Button loading spinner — a border ring with a transparent gap, spun at the slowest transition duration."
  installCode="import { Spinner } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>size</code>', "<code>'sm' | 'md' | 'lg'</code>", "<code>'md'</code>", 'Maps to the icon size scale — 16px, 20px, 24px'],
        ['<code>label</code>', '<code>string</code>', "<code>'Loading'</code>", 'Accessible label announced by screen readers'],
        ['<code>showLabel</code>', '<code>boolean</code>', '<code>false</code>', 'Show the label as visible text beside the spinner'],
      ],
    },
  ]}
  accessibility={[
    '<code>role="status"</code> — screen readers announce the label politely when the spinner appears',
    'The spinning circle is <code>aria-hidden</code>; the label is always in the DOM (visually hidden unless <code>showLabel</code>)',
    'Always describe what is loading — "Loading search results", not just "Loading"',
    '<code>prefers-reduced-motion: reduce</code> replaces the spin with a slow opacity pulse — motion stops, the loading signal remains',
  ]}
>
  <h2>Default</h2>
  <p>Medium spinner with the default "Loading" label for screen readers.</p>
  <SpinnerDefault client:load />
  <pre><code>{`<Spinner />`}</code></pre>

  <h2>Sizes</h2>
  <p>Three sizes mapped to the icon scale: <code>sm</code> (16px), <code>md</code> (20px), <code>lg</code> (24px).</p>
  <SpinnerSizes client:load />
  <pre><code>{`<Spinner size="sm" label="Small spinner" />
<Spinner size="md" label="Medium spinner" />
<Spinner size="lg" label="Large spinner" />`}</code></pre>

  <h2>Visible label</h2>
  <p>Use <code>showLabel</code> to render the label as visible text beside the spinner — useful for inline states like "Checking availability".</p>
  <SpinnerWithLabel client:load />
  <pre><code>{`<Spinner size="sm" label="Checking availability" showLabel />
<Spinner size="md" label="Updating cart" showLabel />
<Spinner size="lg" label="Loading search results" showLabel />`}</code></pre>

  <h2>When to use Button loading instead</h2>
  <p>For loading states inside a button, use the Button component's <code>loading</code> prop — it renders the same spinner and handles <code>aria-busy</code> and interaction blocking for you. Use Spinner for everything else: deferred content areas, inline availability checks, search results.</p>
</ComponentPage>
