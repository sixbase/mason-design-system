---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { SkipLinkDefault, SkipLinkCustom } from '../../components/SkipLinkGallery';
---

<ComponentPage
  title="Skip Link"
  description="A visually hidden link that appears fixed at the top-left of the viewport on keyboard focus, letting keyboard and screen-reader users jump past repeated navigation straight to the main content."
  installCode="import { SkipLink } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>href</code>', '<code>string</code>', "<code>'#main-content'</code>", 'Target of the skip link'],
        ['<code>children</code>', '<code>ReactNode</code>', "<code>'Skip to content'</code>", 'Link text'],
      ],
    },
  ]}
  accessibility={[
    'Must be the <strong>FIRST focusable element on the page</strong> — render it before the header, announcement bar, and any other interactive element',
    'The target element must exist — give your <code>&lt;main&gt;</code> element <code>id="main-content"</code> and <code>tabindex="-1"</code> so focus moves reliably in all browsers',
    'Hidden with the standard sr-only technique (clip + 1px box) — never <code>display: none</code>, which would remove it from the tab order',
    'Appears above all other layers on focus via <code>--z-index-tooltip</code>',
    'Focus ring via <code>box-shadow: var(--focus-ring)</code>; primary background meets WCAG AA contrast',
  ]}
>
  <h2>Default</h2>
  <SkipLinkDefault client:load />
  <pre><code>{`<SkipLink />   {/* "Skip to content" → #main-content */}

<main id="main-content" tabindex="-1">
  ...
</main>`}</code></pre>

  <h2>Custom target and label</h2>
  <SkipLinkCustom client:load />
  <pre><code>{`<SkipLink href="#product-list">Skip to products</SkipLink>`}</code></pre>

  <h2>Placement</h2>
  <p>
    The skip link only works if it is the first thing keyboard users reach.
    Render it as the very first child of <code>&lt;body&gt;</code> — before the
    announcement bar, header, and navigation.
  </p>
  <pre><code>{`<body>
  <SkipLink />              {/* first focusable element */}
  <AnnouncementBar ... />
  <Header ... />
  <main id="main-content" tabindex="-1">
    ...
  </main>
</body>`}</code></pre>
</ComponentPage>
