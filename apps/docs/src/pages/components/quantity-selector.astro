---
import ComponentPage from '../../layouts/ComponentPage.astro';
import { QuantitySelectorDefault, QuantitySelectorEditable, QuantitySelectorSizes, QuantitySelectorStates } from '../../components/QuantitySelectorGallery';
---

<ComponentPage
  title="Quantity Selector"
  description="A controlled stepper for numeric values. Common in ecommerce for cart item quantities. The value is directly editable — typed quantities clamp to min/max. Supports min/max bounds, step increments, and three sizes."
  installCode="import { QuantitySelector } from '@ds/components';"
  props={[
    {
      headers: ['Prop', 'Type', 'Default', 'Description'],
      rows: [
        ['<code>value</code>', '<code>number</code>', '—', 'Current value (controlled)'],
        ['<code>onChange</code>', '<code>(value: number) =&gt; void</code>', '—', 'Called when value changes'],
        ['<code>min</code>', '<code>number</code>', '<code>1</code>', 'Minimum value'],
        ['<code>max</code>', '<code>number</code>', '<code>99</code>', 'Maximum value'],
        ['<code>step</code>', '<code>number</code>', '<code>1</code>', 'Step increment'],
        ['<code>size</code>', "<code>'sm' | 'md' | 'lg'</code>", "<code>'md'</code>", 'Size variant'],
        ['<code>disabled</code>', '<code>boolean</code>', '<code>false</code>', 'Disable interaction'],
      ],
    },
  ]}
  accessibility={[
    'Follows the WAI-ARIA spinbutton pattern — the value is an editable input with <code>role="spinbutton"</code>, <code>aria-valuenow</code>, <code>aria-valuemin</code>, and <code>aria-valuemax</code>',
    'Keyboard: <kbd>↑</kbd>/<kbd>↓</kbd> step the value, <kbd>Home</kbd>/<kbd>End</kbd> jump to min/max, <kbd>Enter</kbd> commits a typed value',
    'The +/- buttons are pointer affordances with descriptive <code>aria-label</code>s, removed from the tab order per the APG spinbutton pattern',
    'Buttons are automatically disabled at min/max bounds',
    '<code>inputMode="numeric"</code> raises the numeric keypad on touch devices; typed values clamp to min/max on blur or Enter',
    'Buttons keep their visual size but expand to 44px touch hit areas on coarse pointers',
  ]}
>
  <h2>Default</h2>
  <QuantitySelectorDefault client:load />
  <pre><code>{`const [qty, setQty] = useState(1);

<QuantitySelector value={qty} onChange={setQty} />`}</code></pre>

  <h2>Typed entry</h2>
  <p>Click the value and type a quantity — it clamps to the min/max bounds (here 1–20) on blur or Enter.</p>
  <QuantitySelectorEditable client:load />
  <pre><code>{`<QuantitySelector value={qty} onChange={setQty} min={1} max={20} />`}</code></pre>

  <h2>Sizes</h2>
  <QuantitySelectorSizes client:load />
  <pre><code>{`<QuantitySelector size="sm" value={qty} onChange={setQty} />
<QuantitySelector size="md" value={qty} onChange={setQty} />  {/* default */}
<QuantitySelector size="lg" value={qty} onChange={setQty} />`}</code></pre>

  <h2>States</h2>
  <p>Disabled state and constrained range (min 1, max 5).</p>
  <QuantitySelectorStates client:load />
  <pre><code>{`<QuantitySelector disabled value={1} onChange={setQty} />
<QuantitySelector value={qty} onChange={setQty} min={1} max={5} />`}</code></pre>
</ComponentPage>
