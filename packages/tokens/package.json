{
  "name": "@ds/tokens",
  "version": "0.1.0",
  "description": "Design tokens — CSS variables, TypeScript constants, and JSON source of truth",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./css": "./dist/tokens.css",
    "./json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs && tsup",
    "dev": "node scripts/build-css.mjs && tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@ds/eslint-config": "workspace:*",
    "@ds/tsconfig": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
